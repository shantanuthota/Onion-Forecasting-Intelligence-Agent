# # Local API / dashboard settings
# API_BASE_URL=http://127.0.0.1:8000
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501
# LOG_LEVEL=INFO

# # Paths (relative paths resolve from project folder)
# ONION_DATA_PATH=data/Onion_Model_Ready_Dataset_Chronos2_2026-10-26_Interpolated_Metric_Quintal.csv
# ONION_DB_PATH=data/onion_forecasting_v4.sqlite3
# CHRONOS_MODEL_ID=amazon/chronos-2

# # Optional ingestion security key. Set this to a long random value before exposing
# # any ingestion endpoint outside localhost. Graph endpoints do not use this key.
# INGESTION_API_KEY=change-this-local-secret

# # Automated 6-hourly UPAg Dash ingestion (pull_upag_dash.py)
# # 1 = job runs when invoked by the scheduled task; 0 = automated runs are skipped.
# UPAG_DASH_ENABLED=1
# # Catch-up depth in days behind yesterday for late/missing source rows.
# UPAG_DASH_DAYS=1
# # Store raw response snapshots under data/snapshots/ and keep the newest N.
# UPAG_DASH_SNAPSHOTS=1
# UPAG_DASH_SNAPSHOT_KEEP=30
# # Corrections to already-present dates are applied when 1; only logged when 0.
# UPAG_DASH_UPDATE_EXISTING=1
# # A held lock older than this many seconds is treated as stale and taken over.
# UPAG_DASH_LOCK_MAX_AGE_SEC=7200
# # Optional in-process APScheduler inside the FastAPI app (needs apscheduler installed).
# UPAG_DASH_INPROC=0

# # Official UPAg Open API connection. Do NOT commit real credentials to Git.
# UPAG_BASE_URL=https://data.upag.gov.in
# UPAG_USERNAME=
# UPAG_PASSWORD=
# UPAG_CLIENT_ID=
# UPAG_CLIENT_SECRET=
# UPAG_SCOPE=
# ============================================================
# Local API / Dashboard Settings
# ============================================================

API_BASE_URL=http://127.0.0.1:8000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501

LOG_LEVEL=INFO


# ============================================================
# API Authentication
# ============================================================

# Required for all data/forecast API routes except CSV import.
# Generate a unique value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=


# ============================================================
# Data / Model Paths
# ============================================================

# Relative paths resolve from the project folder.
ONION_DATA_PATH=data/Onion_Model_Ready_Dataset_Chronos2_2026-10-26_Interpolated_Metric_Quintal.csv

ONION_DB_PATH=data/onion_forecasting_v4.sqlite3

CHRONOS_MODEL_ID=amazon/chronos-2


# ============================================================
# CSV / Data Ingestion Security
# ============================================================

# Separate key used only by the CSV import / ingestion endpoint.
# Set this to a long random value before exposing ingestion
# endpoints outside localhost.
INGESTION_API_KEY=change-this-local-secret


# ============================================================
# Automated 6-Hourly UPAg Dash Ingestion
# ============================================================

# 1 = job runs when invoked by the scheduled task
# 0 = automated runs are skipped
UPAG_DASH_ENABLED=1

# Catch-up depth in days behind yesterday for late/missing source rows.
UPAG_DASH_DAYS=1

# Store raw response snapshots under data/snapshots/
# 1 = enabled, 0 = disabled
UPAG_DASH_SNAPSHOTS=1

# Number of newest snapshots to retain.
UPAG_DASH_SNAPSHOT_KEEP=30

# Corrections to already-present dates:
# 1 = update existing records
# 0 = only log corrections
UPAG_DASH_UPDATE_EXISTING=1

# A held lock older than this many seconds is treated as stale
# and can be taken over.
UPAG_DASH_LOCK_MAX_AGE_SEC=7200

# Optional in-process APScheduler inside the FastAPI app.
# Requires apscheduler to be installed.
# 1 = enabled
# 0 = disabled
UPAG_DASH_INPROC=0


# ============================================================
# Official UPAg Open API Connection
# ============================================================

# Do NOT commit real credentials to Git.
UPAG_BASE_URL=https://data.upag.gov.in

UPAG_USERNAME=
UPAG_PASSWORD=
UPAG_CLIENT_ID=
UPAG_CLIENT_SECRET=
UPAG_SCOPE=
